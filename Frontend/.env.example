# GANT (Global Adimitra Nusaabadi Tracker) Environment Configuration

# Application Metadata
VITE_APP_NAME="GANT — Global Adimitra Nusaabadi Tracker"
VITE_APP_VERSION="0.1.0"
VITE_APP_ENV="production"

# Optional Backend API Base URL (Default: Standalone LocalStorage SPA)
VITE_API_BASE_URL="https://api.gan.co.id/v1"

# Optional NAS Repository Configuration (Simulated Local RAID 5)
VITE_NAS_HOST="192.168.1.100"
VITE_NAS_RAID_STATUS="RAID 5 Healthy"

# Feature Flags
VITE_ENABLE_DEMO_RESET="true"
VITE_ENABLE_XSS_SHIELD="true"
